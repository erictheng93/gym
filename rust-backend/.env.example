# Defaults match backend/docker-compose.yml for local development.
DATABASE_URL=postgresql://gym_nexus:gym_nexus_dev@localhost:15432/gym_nexus
BIND_ADDRESS=127.0.0.1:8056
DB_MAX_CONNECTIONS=5
JWT_SECRET=change-me-in-production
JWT_TTL_SECONDS=86400
RUST_LOG=gym_rust_backend=info,tower_http=info
# Comma-separated list of allowed browser origins (credentials are enabled, so no wildcard)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003,http://127.0.0.1:3004,http://127.0.0.1:3005
