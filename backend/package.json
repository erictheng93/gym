{
  "name": "gym-nexus-api",
  "version": "2.0.0",
  "description": "Gym Nexus API - Built with Hono.js and Drizzle ORM",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsup src/app.ts --format esm --dts",
    "start": "node dist/app.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:backfill-tenant": "tsx src/db/backfill-tenant.ts",
    "migrate:users": "tsx scripts/migrate-users.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.0",
    "@aws-sdk/s3-request-presigner": "^3.726.0",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.7.6",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "hono": "^4.13.19",
    "lucia": "^3.2.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.6.1",
    "postgres": "^3.4.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.18.0",
    "globals": "^17.3.0",
    "supertest": "^7.2.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "brace-expansion": "^5.0.12",
    "nanoid": "^3.3.18",
    "tinypool": "^2.1.2",
    "fast-xml-parser": "^5.12.0",
    "source-map-js": "^1.2.2",
    "qs": "^6.16.1",
    "js-yaml": "^4.3.2",
    "shell-quote": "^1.11.0",
    "postcss": "^8.5.23",
    "esbuild": "^0.28.1",
    "form-data": "^4.0.6",
    "uuid": "^11.1.1",
    "vite": "^6.4.4",
    "nodemailer": "^10.1.4",
    "hono": "^4.13.16",
    "@hono/node-server": "^2.1.3",
    "drizzle-orm": "^0.45.2",
    "@vitest/mocker": "^4.1.12"
  }
}
